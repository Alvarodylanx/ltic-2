# ─────────────────────────────────────────────────────────────────────────────
# Apache .htaccess — www.lticsarl.com
# Place this file in:  /home/USERNAME/www.lticsarl.com/.htaccess
#
# Proxies all requests to the Next.js app running on port 3000.
# ─────────────────────────────────────────────────────────────────────────────

Options -MultiViews -Indexes
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Proxy everything to Next.js on port 3000
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]

# Required for reverse proxy headers
ProxyPassReverse / http://127.0.0.1:3000/

# Security headers
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Cache static Next.js assets aggressively (they have content hashes)
<FilesMatch "\.(js|css|woff2|woff|ttf|png|jpg|jpeg|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
