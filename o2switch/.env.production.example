# ═══════════════════════════════════════════════════════════════════════════
# LTIC SARL — Production Environment Variables
# Copy this file to .env at the project ROOT and fill in every value.
# NEVER commit the real .env to git.
# ═══════════════════════════════════════════════════════════════════════════

# ── DATABASE ────────────────────────────────────────────────────────────────
# Get this from cPanel → PostgreSQL Databases
# Format: postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME
DATABASE_URL=postgresql://ltic_user:YOUR_DB_PASSWORD@localhost:5432/ltic_sarl_prod

# ── SECURITY ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters
SESSION_SECRET=REPLACE_WITH_64_CHARACTER_RANDOM_HEX_STRING

# ── ADMIN ACCOUNT ───────────────────────────────────────────────────────────
ADMIN_EMAIL=contact@lticsarl.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── URLS (must match your real domain) ──────────────────────────────────────
# These are baked into the Next.js build — set them BEFORE running pnpm build
NEXT_PUBLIC_SITE_URL=https://www.lticsarl.com
NEXT_PUBLIC_API_URL=https://api.lticsarl.com

# ── EMAIL / SMTP ─────────────────────────────────────────────────────────────
# Used for contact form, quote requests, and admin notifications
# Brevo (formerly Sendinblue) free tier: 300 emails/day — https://brevo.com
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=YOUR_BREVO_LOGIN_EMAIL
MAIL_PASS=YOUR_BREVO_SMTP_KEY
MAIL_FROM=noreply@lticsarl.com

# ── NOTIFICATIONS ───────────────────────────────────────────────────────────
ADMIN_EMAIL_NOTIFY=contact@lticsarl.com

# ── AI FEATURES (optional) ──────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_KEY_IF_USED
GROQ_API_KEY=YOUR_GROQ_KEY_IF_USED

# ── SERVER ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
